# Read by `docker compose up`/`build` (root .env, picked up automatically
# by compose) to set the backend's JWT signing secret. The default in
# docker-compose.yml is an insecure, clearly-labeled dev value - override
# this before any real deployment, or anyone who reads the source can
# forge valid login tokens.
JWT_SECRET=change-me-to-a-real-random-secret-before-deploying

# Read by `docker compose up`/`build` (root .env) to set the backend's
# Anthropic API key, enabling the case Q&A panel and "ask for a chart"
# analytics feature. No default (unlike JWT_SECRET) - it's a real paid
# external API, not something safe to fake. Leave unset for local dev
# without AI: the affected routes return a clean 503 instead of crashing.
ANTHROPIC_API_KEY=
